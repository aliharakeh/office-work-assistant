<UserControl x:Class="OfficeWorkAssistant.Features.Highlight.HighlightPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:excel="clr-namespace:OfficeWorkAssistant.Excel"
      Background="White">
    <StackPanel Margin="0,4,0,0">
        <TextBlock x:Name="InputInfo" Foreground="#777" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />
        <GroupBox Header="Rules (later rules paint over earlier ones)">
            <StackPanel Margin="6">
                <ListBox x:Name="RuleList" Height="80" Margin="0,0,0,6" SelectionChanged="RuleList_SelectionChanged" />
                <WrapPanel>
                    <Button x:Name="AddBtn" Content="Add rule" Width="100" Margin="0,0,6,4" Click="Add_Click" />
                    <Button Content="Remove" Width="70" Margin="0,0,6,4" Click="Remove_Click" />
                    <Button Content="Up" Width="44" Margin="0,0,6,4" Click="Up_Click" />
                    <Button Content="Down" Width="52" Margin="0,0,6,4" Click="Down_Click" />
                    <Button Content="New" Width="50" Margin="0,0,6,4" Click="New_Click" />
                </WrapPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Rule" Margin="0,8,0,0">
            <StackPanel Margin="6">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Style" VerticalAlignment="Center" />
                    <ComboBox x:Name="TargetBox" Grid.Column="1" SelectionChanged="TargetBox_SelectionChanged">
                        <ComboBoxItem Content="The whole row, when the condition is true" />
                        <ComboBoxItem Content="Each cell in the columns below, tested on its own ($Value)" />
                        <ComboBoxItem Content="The columns below, in rows where the condition is true" />
                    </ComboBox>
                </Grid>
                <StackPanel x:Name="ColumnsPanel" Margin="90,0,0,4">
                    <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ColumnList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Include, Mode=TwoWay}" Margin="0,0,12,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Condition" VerticalAlignment="Center" />
                    <TextBox x:Name="ConditionBox" Grid.Column="1" Margin="0,0,6,0" />
                    <Button Grid.Column="2" Content="Help..." Width="60" Click="Help_Click" />
                </Grid>
                <TextBlock x:Name="ConditionHint" Foreground="#666" Margin="90,0,0,4" TextWrapping="Wrap" />
                <Expander Header="Build a condition" Margin="90,0,0,6">
                    <StackPanel Margin="0,4,0,0">
                        <ComboBox x:Name="BuildColumn" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="BuildOp" Margin="0,0,6,0">
                                <ComboBoxItem Content="==" />
                                <ComboBoxItem Content="!=" />
                                <ComboBoxItem Content="&gt;" />
                                <ComboBoxItem Content="&gt;=" />
                                <ComboBoxItem Content="&lt;" />
                                <ComboBoxItem Content="&lt;=" />
                                <ComboBoxItem Content="contains" />
                                <ComboBoxItem Content="starts with" />
                                <ComboBoxItem Content="ends with" />
                                <ComboBoxItem Content="is empty" />
                                <ComboBoxItem Content="is not empty" />
                            </ComboBox>
                            <TextBox x:Name="BuildValue" Grid.Column="1" Margin="0,0,6,0" ToolTip="A number, text, or a built-in such as $Today." />
                            <Button Grid.Column="2" Content="Use" Width="50" Click="Build_Click" />
                        </Grid>
                    </StackPanel>
                </Expander>
                <TextBlock Text="Look" FontWeight="SemiBold" Margin="0,4,0,4" />
                <excel:CellStylePicker x:Name="StylePicker" />
                <CheckBox x:Name="StopBox" Content="When this rule matches, later rules skip that row (or cell)" Margin="0,6,0,0" />
            </StackPanel>
        </GroupBox>
        <Button Content="Apply to step" Width="120" HorizontalAlignment="Left" Margin="0,8,0,6" Click="Apply_Click" />
        <TextBlock x:Name="Status" Foreground="#777" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
