<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OfficeWorkAssistant.Features.FilterSort.FilterSortPage" Background="White">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OfficeWorkAssistant;component/Excel/EditorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,4,0,0">
        <StackPanel Margin="0,0,0,8" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Preview rows" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#555" TextWrapping="Wrap" />
                <ComboBox x:Name="PreviewBox" SelectionChanged="PreviewBox_SelectionChanged" HorizontalAlignment="Stretch" />
            </StackPanel>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,8">
                <GroupBox Header="Filter rows" Margin="0,0,0,6">
                    <StackPanel Margin="6">
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="Match" VerticalAlignment="Center" Margin="0,0,6,0" TextWrapping="Wrap" />
                            <ComboBox x:Name="MatchMode" Margin="0,0,12,0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="All conditions" />
                                <ComboBoxItem Content="Any condition" />
                            </ComboBox>
                            <Button Content="Variables..." Width="96" Click="Variables_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ListBox x:Name="CondList" Height="72" Margin="0,0,0,6" SelectionChanged="Conds_SelectionChanged" />
                        <WrapPanel Margin="0,0,0,6">
                            <Button x:Name="AddCondBtn" Content="Add condition" Width="110" Margin="0,0,8,4" Click="AddCond_Click" HorizontalAlignment="Left" />
                            <Button Content="Remove" Width="80" Margin="0,0,8,4" Click="RemoveCond_Click" HorizontalAlignment="Left" />
                            <Button Content="Clear" Width="70" Click="ClearCond_Click" HorizontalAlignment="Left" />
                        </WrapPanel>
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="Type" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                            <ComboBox x:Name="CondKind" SelectionChanged="CondKind_Changed" Margin="0,0,0,6" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Column value" />
                                <ComboBoxItem Content="Formula" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="PanelCondColumn" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Column" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                                <ComboBox x:Name="CondColumn" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="Op" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                                <ComboBox x:Name="CondOp" Margin="0,0,0,6" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="==" />
                                    <ComboBoxItem Content="!=" />
                                    <ComboBoxItem Content="&gt;" />
                                    <ComboBoxItem Content="&gt;=" />
                                    <ComboBoxItem Content="&lt;" />
                                    <ComboBoxItem Content="&lt;=" />
                                    <ComboBoxItem Content="contains" />
                                    <ComboBoxItem Content="starts with" />
                                    <ComboBoxItem Content="ends with" />
                                    <ComboBoxItem Content="is empty" />
                                    <ComboBoxItem Content="is not empty" />
                                </ComboBox>
                                <TextBlock Text="Value" TextWrapping="Wrap" Margin="0,4,0,2" />
                                <TextBox x:Name="CondValue" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                                <Button Content="Unique..." Width="80" Click="UniqueValues_Click" Margin="0,0,0,6" HorizontalAlignment="Left" />
                            </StackPanel>
                            <TextBlock Text="Keeps rows where the column passes. The value may use a built-in like $Today. Text checks ignore case." Foreground="#666" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="PanelCondFormula" Margin="0,0,0,6" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Formula" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                                <TextBox x:Name="CondFormula" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <TextBlock Text="Checked on every row; true keeps it. $A $B are columns (A = 1st, B = 2nd). E.g. $A &gt; 10 &amp;&amp; $B == &quot;OK&quot;, CONTAINS($C, &quot;x&quot;), $D &gt; $Today." Foreground="#666" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Data file" Visibility="Collapsed" Margin="0,0,0,6">
                    <StackPanel Margin="6">
                        <TextBox x:Name="SourcePath" IsReadOnly="True" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="InfoSource" Margin="0,0,0,6" Foreground="#777" FontSize="11" Text="No file loaded." TextWrapping="Wrap" />
                        <DataGrid x:Name="GridSource" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="240" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <GroupBox Header="Columns to keep" Margin="0,0,0,6">
                    <StackPanel Margin="6">
                        <CheckBox x:Name="SelectAllKeep" Content="Select all" Margin="12,0,0,0" VerticalAlignment="Center" IsThreeState="True" Click="SelectAllKeep_Click" />
                        <TextBlock Text="Unchecked columns are removed from the result." Foreground="#666" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ScrollViewer MaxHeight="84" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="KeepColumnList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding Include, Mode=TwoWay}" Margin="0,0,12,4" Checked="KeepColumn_Changed" Unchecked="KeepColumn_Changed" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Sort by" Margin="0,0,0,6">
                    <StackPanel Margin="6">
                        <ListBox x:Name="SortList" Height="60" Margin="0,0,0,6" SelectionChanged="Sorts_SelectionChanged" />
                        <WrapPanel Margin="0,0,0,6">
                            <Button x:Name="AddSortBtn" Content="Add sort" Width="90" Margin="0,0,8,4" Click="AddSort_Click" HorizontalAlignment="Left" />
                            <Button Content="Remove" Width="70" Margin="0,0,8,4" Click="RemoveSort_Click" HorizontalAlignment="Left" />
                            <Button Content="Up" Width="40" Margin="0,0,8,4" Click="SortUp_Click" HorizontalAlignment="Left" />
                            <Button Content="Down" Width="48" Click="SortDown_Click" HorizontalAlignment="Left" />
                        </WrapPanel>
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="Column" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                            <ComboBox x:Name="SortColumn" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Direction" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                            <ComboBox x:Name="SortDirection" Margin="0,0,0,6" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Ascending" />
                                <ComboBoxItem Content="Descending" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            <StackPanel Grid.Row="2">
                <Button x:Name="UseBtn" Content="Apply to step" Width="120" HorizontalAlignment="Left" Margin="0,0,0,6" Click="UseInPipeline_Click" />
                <TextBlock x:Name="InfoOut" Foreground="#777" FontSize="11" TextWrapping="Wrap" />
                <DataGrid x:Name="GridOut" Visibility="Collapsed" AutoGenerateColumns="True" IsReadOnly="True" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
