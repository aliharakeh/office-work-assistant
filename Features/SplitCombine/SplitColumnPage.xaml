<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OfficeWorkAssistant.Features.SplitCombine.SplitColumnPage" Background="White">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OfficeWorkAssistant;component/Excel/EditorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,4,0,0">
        <TextBlock x:Name="InputInfo" Foreground="#777" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />
        <GroupBox Header="Split">
            <StackPanel Margin="6">
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="Column" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                    <ComboBox x:Name="ColumnBox" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="Split by" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                    <ComboBox x:Name="ModeBox" SelectionChanged="ModeBox_SelectionChanged" Margin="0,0,0,6" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Delimiter (text between the parts)" />
                        <ComboBoxItem Content="Fixed widths (character counts)" />
                        <ComboBoxItem Content="Pattern (regular expression)" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,0,2">
                    <TextBlock x:Name="ValueLabel" Text="Delimiter" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                    <TextBox x:Name="ValueBox" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                </StackPanel>
                <TextBlock x:Name="ValueHint" Foreground="#666" Margin="0,0,0,6" TextWrapping="Wrap" />
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="Max parts" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                    <TextBox x:Name="MaxBox" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                    <TextBlock Text="  0 = all. Otherwise the last part keeps the rest." Foreground="#666" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,2" />
                </StackPanel>
                <StackPanel Margin="0,0,0,2">
                    <TextBlock Text="New headers" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                    <TextBox x:Name="HeadersBox" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                </StackPanel>
                <TextBlock Text="Comma-separated, e.g. First name, Last name. Blank ones become &quot;Column 1&quot;, &quot;Column 2&quot;." Foreground="#666" Margin="0,0,0,6" TextWrapping="Wrap" />
                <CheckBox x:Name="TrimBox" Content="Remove spaces around each part" Margin="0,0,0,2" />
                <CheckBox x:Name="KeepBox" Content="Keep the original column" />
            </StackPanel>
        </GroupBox>
        <Button Content="Apply to step" Width="120" HorizontalAlignment="Left" Margin="0,8,0,6" Click="Apply_Click" />
        <TextBlock x:Name="Status" Foreground="#777" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
