<UserControl x:Class="OfficeWorkAssistant.Features.SplitCombine.CombineColumnsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White">
    <StackPanel Margin="0,4,0,0">
        <TextBlock x:Name="InputInfo" Foreground="#777" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />
        <GroupBox Header="Columns to join, in order">
            <StackPanel Margin="6">
                <ListBox x:Name="PartList" Height="90" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ColumnBox" Margin="0,0,6,0" />
                    <Button Grid.Column="1" Content="Add" Width="50" Click="Add_Click" />
                </Grid>
                <WrapPanel>
                    <Button Content="Up" Width="50" Margin="0,0,6,4" Click="Up_Click" />
                    <Button Content="Down" Width="56" Margin="0,0,6,4" Click="Down_Click" />
                    <Button Content="Remove" Width="70" Margin="0,0,6,4" Click="Remove_Click" />
                </WrapPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Result" Margin="0,8,0,0">
            <StackPanel Margin="6">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Separator" VerticalAlignment="Center" />
                    <TextBox x:Name="SeparatorBox" Grid.Column="1" ToolTip="Put between the values. \t is a tab, \n a line break." />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Header" VerticalAlignment="Center" />
                    <TextBox x:Name="HeaderBox" Grid.Column="1" />
                </Grid>
                <CheckBox x:Name="SkipBox" Content="Skip empty values (no double separators)" Margin="0,0,0,2" />
                <CheckBox x:Name="RemoveBox" Content="Remove the joined columns" />
            </StackPanel>
        </GroupBox>
        <Button Content="Apply to step" Width="120" HorizontalAlignment="Left" Margin="0,8,0,6" Click="Apply_Click" />
        <TextBlock x:Name="Status" Foreground="#777" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
