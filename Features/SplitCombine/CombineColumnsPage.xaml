<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OfficeWorkAssistant.Features.SplitCombine.CombineColumnsPage" Background="White">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OfficeWorkAssistant;component/Excel/EditorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,4,0,0">
        <TextBlock x:Name="InputInfo" Foreground="#777" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />
        <GroupBox Header="Columns to join, in order">
            <StackPanel Margin="6">
                <ListBox x:Name="PartList" Height="90" Margin="0,0,0,6" />
                <StackPanel Margin="0,0,0,4">
                    <ComboBox x:Name="ColumnBox" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                    <Button Content="Add" Width="50" Click="Add_Click" Margin="0,0,0,6" HorizontalAlignment="Left" />
                </StackPanel>
                <WrapPanel>
                    <Button Content="Up" Width="50" Margin="0,0,6,4" Click="Up_Click" HorizontalAlignment="Left" />
                    <Button Content="Down" Width="56" Margin="0,0,6,4" Click="Down_Click" HorizontalAlignment="Left" />
                    <Button Content="Remove" Width="70" Margin="0,0,6,4" Click="Remove_Click" HorizontalAlignment="Left" />
                </WrapPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Result" Margin="0,8,0,0">
            <StackPanel Margin="6">
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="Separator" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                    <TextBox x:Name="SeparatorBox" ToolTip="Put between the values. \t is a tab, \n a line break." Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="Header" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                    <TextBox x:Name="HeaderBox" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                </StackPanel>
                <CheckBox x:Name="SkipBox" Content="Skip empty values (no double separators)" Margin="0,0,0,2" />
                <CheckBox x:Name="RemoveBox" Content="Remove the joined columns" />
            </StackPanel>
        </GroupBox>
        <Button Content="Apply to step" Width="120" HorizontalAlignment="Left" Margin="0,8,0,6" Click="Apply_Click" />
        <TextBlock x:Name="Status" Foreground="#777" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
