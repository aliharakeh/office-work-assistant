<Page x:Class="OfficeWorkAssistant.Features.FileOps.ValueListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="List / set / map"
      Background="White">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
            <Button DockPanel.Dock="Left" Content="Back" Width="72" Margin="0,0,12,0" Click="Back_Click" />
            <Button DockPanel.Dock="Right" Content="Use in pipeline" Padding="10,1" Click="Use_Click" />
            <TextBlock Text="List / set / map" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <GroupBox DockPanel.Dock="Top" Header="Build" Margin="0,0,0,8">
            <StackPanel Margin="6">
                <TextBlock x:Name="InputInfo" Foreground="#777" FontSize="11" Margin="0,0,0,6" />
                <WrapPanel Margin="0,0,0,6">
                    <RadioButton x:Name="SrcInput" Content="From the input step (rebuilt on every run)" Margin="0,0,16,0" Checked="Changed" />
                    <RadioButton x:Name="SrcStored" Content="Stored values (kept in the pipeline file)" Checked="Changed" />
                </WrapPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Kind" VerticalAlignment="Center" />
                    <ComboBox x:Name="ModeBox" Grid.Column="1" Width="260" SelectionChanged="Changed">
                        <ComboBoxItem Content="List (every row)" />
                        <ComboBoxItem Content="Set (unique keys)" />
                        <ComboBoxItem Content="Map (unique keys with a value)" />
                    </ComboBox>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Key formula" VerticalAlignment="Center" />
                    <TextBox x:Name="KeyBox" Grid.Column="1"
                             ToolTip="Per input row. Columns by header ($Code) or letter ($A). Example: TRIM($Code) or $Code &amp; &quot;_&quot; &amp; $Year" />
                </Grid>
                <Grid x:Name="ValueRow" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Value formula" VerticalAlignment="Center" />
                    <TextBox x:Name="ValueBox" Grid.Column="1"
                             ToolTip="Map only: the value stored with each key. Example: $Customer" />
                </Grid>
                <WrapPanel>
                    <CheckBox x:Name="TrimBox" Content="Trim spaces" Margin="0,0,16,0" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed" />
                    <CheckBox x:Name="SkipBox" Content="Skip blank keys" Margin="0,0,16,0" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed" />
                    <TextBlock x:Name="DupLabel" Text="Same key twice:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="DupBox" Width="130" Margin="0,0,16,0" SelectionChanged="Changed">
                        <ComboBoxItem Content="Keep the first" />
                        <ComboBoxItem Content="Keep the last" />
                        <ComboBoxItem Content="Stop with an error" />
                    </ComboBox>
                    <Button x:Name="CaptureBtn" Content="Capture from input" Padding="8,1" Margin="0,0,6,0" Click="Capture_Click"
                            ToolTip="Store what the input gives now, and switch to stored values." />
                    <Button Content="Preview" Width="80" Click="Preview_Click" />
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox x:Name="StoredGroup" Header="Stored values (type or paste; new row at the bottom)" Margin="0,0,6,0">
                <DataGrid x:Name="StoredGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                          HeadersVisibility="Column" Margin="6">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <GroupBox Header="Result" Grid.Column="1" Margin="6,0,0,0">
                <DockPanel Margin="6">
                    <TextBlock x:Name="ResultInfo" DockPanel.Dock="Top" Foreground="#777" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <DataGrid x:Name="ResultGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" />
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Page>
