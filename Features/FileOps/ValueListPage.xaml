<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OfficeWorkAssistant.Features.FileOps.ValueListPage" Background="White">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OfficeWorkAssistant;component/Excel/EditorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,4,0,0">
        <StackPanel Margin="0,0,0,8">
            <Button Content="Apply to step" Padding="10,1" Click="Use_Click" HorizontalAlignment="Left" />
        </StackPanel>
        <GroupBox Header="Build" Margin="0,0,0,8">
            <StackPanel Margin="6">
                <TextBlock x:Name="InputInfo" Foreground="#777" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />
                <StackPanel Margin="0,0,0,6">
                    <RadioButton x:Name="SrcInput" Content="From the input step (rebuilt on every run)" Margin="0,0,16,0" Checked="Changed" />
                    <RadioButton x:Name="SrcStored" Content="Stored values (kept in the pipeline file)" Checked="Changed" />
                </StackPanel>
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="Kind" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                    <ComboBox x:Name="ModeBox" SelectionChanged="Changed" Margin="0,0,0,6" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="List (every row)" />
                        <ComboBoxItem Content="Set (unique keys)" />
                        <ComboBoxItem Content="Map (unique keys with a value)" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="Key formula" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                    <TextBox x:Name="KeyBox" ToolTip="Per input row. Columns by header ($Code) or letter ($A). Example: TRIM($Code) or $Code &amp; &quot;_&quot; &amp; $Year" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel x:Name="ValueRow" Margin="0,0,0,6">
                    <TextBlock Text="Value formula" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                    <TextBox x:Name="ValueBox" ToolTip="Map only: the value stored with each key. Example: $Customer" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel>
                    <CheckBox x:Name="TrimBox" Content="Trim spaces" Margin="0,0,16,0" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed" />
                    <CheckBox x:Name="SkipBox" Content="Skip blank keys" Margin="0,0,16,0" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed" />
                    <TextBlock x:Name="DupLabel" Text="Same key twice:" VerticalAlignment="Center" Margin="0,0,6,0" TextWrapping="Wrap" />
                    <ComboBox x:Name="DupBox" Margin="0,0,16,0" SelectionChanged="Changed" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Keep the first" />
                        <ComboBoxItem Content="Keep the last" />
                        <ComboBoxItem Content="Stop with an error" />
                    </ComboBox>
                    <Button x:Name="CaptureBtn" Content="Capture from input" Padding="8,1" Margin="0,0,6,4" Click="Capture_Click" ToolTip="Store what the input gives now, and switch to stored values." HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <StackPanel>
            <GroupBox x:Name="StoredGroup" Header="Stored values (type or paste; new row at the bottom)" Margin="0,0,0,6">
                <DataGrid x:Name="StoredGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" HeadersVisibility="Column" Margin="6">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </StackPanel>
    </StackPanel>
</UserControl>
