<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OfficeWorkAssistant.Features.FileOps.FileActionPage" Background="White">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OfficeWorkAssistant;component/Excel/EditorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,4,0,0">
        <StackPanel Margin="0,0,0,8">
            <Button Content="Apply to step" Padding="10,1" Click="Use_Click" HorizontalAlignment="Left" />
        </StackPanel>
        <GroupBox Header="Action" Margin="0,0,0,8">
            <StackPanel Margin="6">
                <TextBlock x:Name="InputInfo" Foreground="#777" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />
                <StackPanel Margin="0,0,0,6">
                    <RadioButton x:Name="CopyRadio" Content="Copy" Margin="0,0,16,0" Checked="Action_Changed" />
                    <RadioButton x:Name="MoveRadio" Content="Move" Margin="0,0,16,0" Checked="Action_Changed" />
                    <RadioButton x:Name="DeleteRadio" Content="Delete" Margin="0,0,24,0" Checked="Action_Changed" />
                    <TextBlock Text="Paths in column" VerticalAlignment="Center" Margin="0,0,6,0" TextWrapping="Wrap" />
                    <ComboBox x:Name="PathColBox" IsEditable="True" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel x:Name="DestPanel">
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Destination" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                        <TextBox x:Name="DestBox" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                        <Button Content="Browse..." Width="88" Click="Browse_Click" Margin="0,0,0,6" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Subfolder for files" TextWrapping="Wrap" Margin="0,4,0,2" />
                        <TextBox x:Name="FileSubBox" Margin="0,0,0,6" ToolTip="Optional. A folder under Destination for each file; \ makes nested folders. Example: $Key  or  $Value &amp; &quot;\&quot; &amp; $Key" HorizontalAlignment="Stretch" />
                        <TextBlock Text="New name for files" TextWrapping="Wrap" Margin="0,4,0,2" />
                        <TextBox x:Name="FileNameBox" ToolTip="Optional. Blank keeps the name. The extension is kept. Example: $Key &amp; &quot;-&quot; &amp; $Stem" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                        <TextBlock Text="Subfolder for folders" TextWrapping="Wrap" Margin="0,4,0,2" />
                        <TextBox x:Name="FolderSubBox" Margin="0,0,0,6" ToolTip="Optional. A folder under Destination for each folder; \ makes nested folders. Example: $Value" HorizontalAlignment="Stretch" />
                        <TextBlock Text="New name for folders" TextWrapping="Wrap" Margin="0,4,0,2" />
                        <TextBox x:Name="FolderNameBox" Margin="0,0,0,6" ToolTip="Optional. Blank keeps the name. Example: $Key &amp; &quot; &quot; &amp; $Value" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <CheckBox x:Name="StructureBox" Content="Keep folder structure (Relative column)" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock Text="If it exists" VerticalAlignment="Center" Margin="0,0,6,0" TextWrapping="Wrap" />
                        <ComboBox x:Name="ConflictBox" Margin="0,0,16,0" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Skip it" />
                            <ComboBoxItem Content="Overwrite" />
                            <ComboBoxItem Content="Rename to name (2)" />
                        </ComboBox>
                        <TextBlock Text="Split $1 $2 by" VerticalAlignment="Center" Margin="0,0,6,0" TextWrapping="Wrap" />
                        <TextBox x:Name="SepBox" MaxLength="1" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="DeletePanel" Margin="0,0,0,6">
                    <CheckBox x:Name="PermanentBox" Content="Delete permanently (skip the Recycle Bin)" Checked="Action_Changed" Unchecked="Action_Changed" />
                    <TextBlock x:Name="PermanentWarn" Text="Permanently deleted files cannot be restored." Foreground="#C62828" Margin="20,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" Text="Nothing is copied, moved or deleted here or by Run preview: files change only on Run and save files, after every step worked and you confirm." />
                <WrapPanel>
                    <Button Content="Variables..." Width="88" Margin="0,0,6,4" Click="Variables_Click" HorizontalAlignment="Left" />
                </WrapPanel>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
