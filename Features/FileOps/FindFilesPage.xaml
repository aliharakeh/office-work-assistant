<Page x:Class="OfficeWorkAssistant.Features.FileOps.FindFilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Find files"
      Background="White">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
            <Button DockPanel.Dock="Left" Content="Back" Width="72" Margin="0,0,12,0" Click="Back_Click" />
            <Button DockPanel.Dock="Right" Content="Use in pipeline" Padding="10,1" Click="Use_Click" />
            <TextBlock x:Name="HeaderTitle" Text="Find files" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <GroupBox DockPanel.Dock="Top" Header="Search" Margin="0,0,0,8">
            <StackPanel Margin="6">
                <TextBlock x:Name="InputInfo" Foreground="#777" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Folder" VerticalAlignment="Center" />
                    <TextBox x:Name="FolderBox" Grid.Column="1" Margin="0,0,6,0" />
                    <Button Grid.Column="2" Content="Browse..." Width="88" Click="Browse_Click" />
                </Grid>
                <WrapPanel Margin="88,0,0,6">
                    <TextBlock Text="Look for" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="IncludeBox" Width="140" Margin="0,0,16,0" SelectionChanged="Include_Changed">
                        <ComboBoxItem Content="Files" />
                        <ComboBoxItem Content="Folders" />
                        <ComboBoxItem Content="Files and folders" />
                    </ComboBox>
                    <CheckBox x:Name="RecurseBox" Content="Include subfolders" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="Split $1 $2 by" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="SepBox" Width="30" MaxLength="1" />
                </WrapPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="File filter" VerticalAlignment="Center" />
                    <TextBox x:Name="FileFilterBox" Grid.Column="1"
                             ToolTip="Optional. Only files where this is true are kept. Example: $Ext == &quot;.pdf&quot; &amp;&amp; $Modified &gt; $MonthAgo" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Folder filter" VerticalAlignment="Center" />
                    <TextBox x:Name="FolderFilterBox" Grid.Column="1"
                             ToolTip="Optional. Only folders where this is true are kept (files inside are still searched). Example: STARTSWITH($Name, &quot;20&quot;)" />
                </Grid>

                <StackPanel x:Name="MatchPanel">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Match key" VerticalAlignment="Center" />
                        <ComboBox x:Name="MatchBox" Grid.Column="1" Width="260" SelectionChanged="Match_Changed">
                            <ComboBoxItem Content="Name equals key" />
                            <ComboBoxItem Content="Name without extension equals key" />
                            <ComboBoxItem Content="Name contains key" />
                            <ComboBoxItem Content="Name starts with key" />
                            <ComboBoxItem Content="Name ends with key" />
                            <ComboBoxItem Content="Formulas (one for files, one for folders)" />
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="File match" VerticalAlignment="Center" />
                        <TextBox x:Name="FileFormulaBox" Grid.Column="1"
                                 ToolTip="True when a file belongs to the key. Example: $1 == $Key &amp;&amp; $Ext == &quot;.pdf&quot;" />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Folder match" VerticalAlignment="Center" />
                        <TextBox x:Name="FolderFormulaBox" Grid.Column="1"
                                 ToolTip="True when a folder belongs to the key. Example: $Name == $Key  or  STARTSWITH($Name, $Key &amp; &quot;_&quot;)" />
                    </Grid>
                    <WrapPanel Margin="88,0,0,6">
                        <CheckBox x:Name="UnmatchedBox" Content="Keep keys with no match (Found = FALSE)" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <CheckBox x:Name="InsideBox" Content="Skip items inside a matched folder" VerticalAlignment="Center" />
                    </WrapPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="88,0,0,0">
                    <Button Content="Variables..." Width="88" Margin="0,0,6,0" Click="Variables_Click" />
                    <Button Content="Preview" Width="88" Click="Preview_Click" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Result">
            <DockPanel Margin="6">
                <TextBlock x:Name="ResultInfo" DockPanel.Dock="Top" Foreground="#777" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"
                           Text="Click Preview to search. Nothing is changed on disk." />
                <DataGrid x:Name="ResultGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" />
            </DockPanel>
        </GroupBox>
    </DockPanel>
</Page>
