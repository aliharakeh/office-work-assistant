<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OfficeWorkAssistant.Features.FileOps.FindFilesPage" Background="White">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OfficeWorkAssistant;component/Excel/EditorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,4,0,0">
        <StackPanel Margin="0,0,0,8">
            <Button Content="Apply to step" Padding="10,1" Click="Use_Click" HorizontalAlignment="Left" />
        </StackPanel>
        <GroupBox Header="Search" Margin="0,0,0,8">
            <StackPanel Margin="6">
                <TextBlock x:Name="InputInfo" Foreground="#777" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="Folder" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                    <TextBox x:Name="FolderBox" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                    <Button Content="Browse..." Width="88" Click="Browse_Click" Margin="0,0,0,6" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="Look for" VerticalAlignment="Center" Margin="0,0,6,0" TextWrapping="Wrap" />
                    <ComboBox x:Name="IncludeBox" Margin="0,0,16,0" SelectionChanged="Include_Changed" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Files" />
                        <ComboBoxItem Content="Folders" />
                        <ComboBoxItem Content="Files and folders" />
                    </ComboBox>
                    <CheckBox x:Name="RecurseBox" Content="Include subfolders" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="Split $1 $2 by" VerticalAlignment="Center" Margin="0,0,6,0" TextWrapping="Wrap" />
                    <TextBox x:Name="SepBox" MaxLength="1" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="File filter" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                    <TextBox x:Name="FileFilterBox" ToolTip="Optional. Only files where this is true are kept. Example: $Ext == &quot;.pdf&quot; &amp;&amp; $Modified &gt; $MonthAgo" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="Folder filter" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                    <TextBox x:Name="FolderFilterBox" ToolTip="Optional. Only folders where this is true are kept (files inside are still searched). Example: STARTSWITH($Name, &quot;20&quot;)" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel x:Name="MatchPanel">
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Match key" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                        <ComboBox x:Name="MatchBox" SelectionChanged="Match_Changed" Margin="0,0,0,6" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Name equals key" />
                            <ComboBoxItem Content="Name without extension equals key" />
                            <ComboBoxItem Content="Name contains key" />
                            <ComboBoxItem Content="Name starts with key" />
                            <ComboBoxItem Content="Name ends with key" />
                            <ComboBoxItem Content="Formulas (one for files, one for folders)" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="File match" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                        <TextBox x:Name="FileFormulaBox" ToolTip="True when a file belongs to the key. Example: $1 == $Key &amp;&amp; $Ext == &quot;.pdf&quot;" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Folder match" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                        <TextBox x:Name="FolderFormulaBox" ToolTip="True when a folder belongs to the key. Example: $Name == $Key  or  STARTSWITH($Name, $Key &amp; &quot;_&quot;)" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <CheckBox x:Name="UnmatchedBox" Content="Keep keys with no match (Found = FALSE)" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <CheckBox x:Name="InsideBox" Content="Skip items inside a matched folder" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <WrapPanel Margin="0,0,0,0">
                    <Button Content="Variables..." Width="88" Margin="0,0,6,4" Click="Variables_Click" HorizontalAlignment="Left" />
                </WrapPanel>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
