<Page x:Class="WorkAssistant.Features.CopyFiles.CopyFilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Copy Files"
      Background="White">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
            <Button DockPanel.Dock="Left" Content="Home" Width="72" Margin="0,0,12,0" Click="Home_Click" />
            <TextBlock Text="Copy Files" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Preview" Width="100" Margin="0,0,8,0" Click="Preview_Click" />
            <Button Content="Copy" Width="100" Click="Copy_Click" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <GroupBox Header="Copy" Margin="0,0,0,8">
                <StackPanel Margin="6">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Source" VerticalAlignment="Center" />
                        <TextBox x:Name="PathSource" Grid.Column="1" IsReadOnly="True" Margin="0,0,6,0" />
                        <Button Grid.Column="2" Content="Browse..." Width="88" Click="BrowseSource_Click" />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Destination" VerticalAlignment="Center" />
                        <TextBox x:Name="PathDest" Grid.Column="1" IsReadOnly="True" Margin="0,0,6,0" />
                        <Button Grid.Column="2" Content="Browse..." Width="88" Click="BrowseDest_Click" />
                    </Grid>
                    <WrapPanel>
                        <CheckBox x:Name="RecurseBox" Content="Include subfolders" VerticalAlignment="Center" Margin="0,0,16,6" />
                        <CheckBox x:Name="WrapBox" Content="Create wrapper folder" VerticalAlignment="Center" Margin="0,0,16,6" Checked="WrapBox_Changed" Unchecked="WrapBox_Changed" />
                        <CheckBox x:Name="FolderOnlyBox" Content="Pattern on folder only" VerticalAlignment="Center" Margin="0,0,16,6" IsEnabled="False" ToolTip="Keep the original file name inside the renamed wrapper folder." />
                        <TextBlock Text="Separator" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <ComboBox x:Name="SepBox" Width="110" Margin="0,0,8,6" SelectedIndex="1" SelectionChanged="SepBox_Changed">
                            <ComboBoxItem Content="Space" />
                            <ComboBoxItem Content="Underscore" />
                            <ComboBoxItem Content="Dash" />
                            <ComboBoxItem Content="Custom" />
                        </ComboBox>
                        <TextBox x:Name="CustomSep" Width="40" MaxLength="1" IsEnabled="False" Margin="0,0,16,6" />
                        <TextBlock Text="Pattern" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox x:Name="PatternBox" Width="160" Text="$1" Margin="0,0,0,6" />
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Text="Extensions" VerticalAlignment="Center" Margin="0,0,6,6" ToolTip="Blank = all files. Example: .pdf, .docx" />
                        <TextBox x:Name="ExtFilterBox" Width="160" Margin="0,0,16,6" ToolTip="Blank = all files. Example: .pdf, .docx" />
                        <TextBlock Text="Name contains" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox x:Name="ContainsBox" Width="140" Margin="0,0,16,6" ToolTip="Blank = all files. Only copy files whose name contains this text." />
                        <TextBlock Text="Folder contains" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox x:Name="FolderBox" Width="140" Margin="0,0,0,6" ToolTip="Blank = all folders. Only copy files whose folder path (relative to Source) contains this text." />
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Preview" Grid.Row="1">
                <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="True" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column" Margin="6" />
            </GroupBox>
        </Grid>
    </DockPanel>
</Page>
