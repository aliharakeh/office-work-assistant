<Page x:Class="WorkAssistant.Features.CopyFiles.CopyFilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Copy Files"
      Background="White">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
            <Button DockPanel.Dock="Left" Content="Home" Width="72" Margin="0,0,12,0" Click="Home_Click" />
            <TextBlock Text="Copy Files" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Preview" Width="100" Margin="0,0,8,0" Click="Preview_Click" />
            <Button Content="Copy" Width="100" Click="Copy_Click" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <GroupBox Header="Copy" Margin="0,0,0,8">
                <StackPanel Margin="6">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Source" VerticalAlignment="Center" />
                        <TextBox x:Name="PathSource" Grid.Column="1" IsReadOnly="True" Margin="0,0,6,0" />
                        <Button Grid.Column="2" Content="Browse..." Width="88" Click="BrowseSource_Click" />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Destination" VerticalAlignment="Center" />
                        <TextBox x:Name="PathDest" Grid.Column="1" IsReadOnly="True" Margin="0,0,6,0" />
                        <Button Grid.Column="2" Content="Browse..." Width="88" Click="BrowseDest_Click" />
                    </Grid>
                    <WrapPanel>
                        <CheckBox x:Name="RecurseBox" Content="Include subfolders" VerticalAlignment="Center" Margin="0,0,16,6" />
                        <CheckBox x:Name="WrapBox" Content="Create wrapper folder" VerticalAlignment="Center" Margin="0,0,0,6" Checked="WrapBox_Changed" Unchecked="WrapBox_Changed" />
                    </WrapPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="File filter" VerticalAlignment="Center" />
                        <TextBox x:Name="FileFilterBox" Grid.Column="1"
                                 ToolTip="Blank = all files. Formula must be true. {Name} {Stem} {Ext} {Path} {Folder} {FolderName} {Relative} {Size} {Modified} $1 from the file split. Example: CONTAINS({Name}, &quot;report&quot;) &amp;&amp; {Ext} == &quot;.pdf&quot;" />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Folder filter" VerticalAlignment="Center" />
                        <TextBox x:Name="FolderFilterBox" Grid.Column="1"
                                 ToolTip="Blank = all folders. Formula must be true for the file's folder. {Name} {Path} {Relative} $1 from the folder split. Combined with File filter. Example: CONTAINS({Relative}, &quot;2024&quot;)" />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="File split" VerticalAlignment="Center" />
                        <ComboBox x:Name="FileSepBox" Grid.Column="1" Width="110" Margin="0,0,8,0" SelectedIndex="1" SelectionChanged="FileSep_Changed">
                            <ComboBoxItem Content="Space" />
                            <ComboBoxItem Content="Underscore" />
                            <ComboBoxItem Content="Dash" />
                            <ComboBoxItem Content="Custom" />
                        </ComboBox>
                        <TextBox x:Name="FileCustomSep" Grid.Column="2" Width="40" MaxLength="1" IsEnabled="False" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="3" Text="File pattern" VerticalAlignment="Center" />
                        <TextBox x:Name="FilePatternBox" Grid.Column="4" Text="$1"
                                 ToolTip="Formula for the new file name (extension is kept). $1 $2 split the file stem with File split. {Stem} {Name} TRIM() FORMAT() IF() &amp; for text." />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Folder split" VerticalAlignment="Center" />
                        <ComboBox x:Name="FolderSepBox" Grid.Column="1" Width="110" Margin="0,0,8,0" SelectedIndex="1" SelectionChanged="FolderSep_Changed">
                            <ComboBoxItem Content="Space" />
                            <ComboBoxItem Content="Underscore" />
                            <ComboBoxItem Content="Dash" />
                            <ComboBoxItem Content="Custom" />
                        </ComboBox>
                        <TextBox x:Name="FolderCustomSep" Grid.Column="2" Width="40" MaxLength="1" IsEnabled="False" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="3" Text="Folder pattern" VerticalAlignment="Center" />
                        <TextBox x:Name="FolderPatternBox" Grid.Column="4" IsEnabled="False" Text="$1"
                                 ToolTip="Used when Create wrapper folder is on. $1 $2 split the source folder name with Folder split. {Name} {Path} {Relative}." />
                    </Grid>
                    <TextBlock Margin="88,0,0,6" Foreground="#666" TextWrapping="Wrap"
                               Text="File $1 splits the file name. Folder $1 splits the source folder name. Glue text with &amp;. $1-$2 subtracts." />
                    <Button Content="Variables..." Width="88" HorizontalAlignment="Left" Click="Variables_Click" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Preview" Grid.Row="1">
                <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="True" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column" Margin="6" />
            </GroupBox>
        </Grid>
    </DockPanel>
</Page>
