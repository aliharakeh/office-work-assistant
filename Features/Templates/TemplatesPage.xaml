<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OfficeWorkAssistant.Features.Templates.TemplatesPage" Background="White">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OfficeWorkAssistant;component/Excel/EditorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,4,0,0">
        <StackPanel Margin="0,0,0,8" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Preview rows" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#555" TextWrapping="Wrap" />
                <ComboBox x:Name="PreviewBox" SelectionChanged="PreviewBox_SelectionChanged" HorizontalAlignment="Stretch" />
            </StackPanel>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,8">
                <GroupBox Header="Add columns" Margin="0,0,0,6">
                    <StackPanel Margin="6">
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,4,0,2" TextWrapping="Wrap" />
                            <TextBox x:Name="TemplateName" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <CheckBox x:Name="KeepSource" Content="Keep source columns" IsChecked="True" Margin="0,0,0,6" Checked="KeepSource_Changed" Unchecked="KeepSource_Changed" />
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="Source columns" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <CheckBox x:Name="SelectAllSource" Content="Select all" Margin="12,0,0,0" VerticalAlignment="Center" IsThreeState="True" Click="SelectAllSource_Click" />
                        </StackPanel>
                        <ScrollViewer MaxHeight="110" Margin="0,0,0,6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SourceColumnList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding Include, Mode=TwoWay}" Margin="0,0,12,4" Checked="SourceColumn_Changed" Unchecked="SourceColumn_Changed" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="Extra columns" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                        <Button Content="Add column" Width="100" HorizontalAlignment="Left" Margin="0,0,0,4" Click="AddUpdate_Click" />
                        <StackPanel x:Name="ColumnPanel" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Data file" Visibility="Collapsed" Margin="0,0,0,6">
                    <StackPanel Margin="6">
                        <TextBox x:Name="SourcePath" IsReadOnly="True" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="InfoSource" Margin="0,0,0,6" Foreground="#777" FontSize="11" Text="No file loaded." TextWrapping="Wrap" />
                        <DataGrid x:Name="GridSource" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            <StackPanel Grid.Row="1">
                <WrapPanel Margin="0,0,0,6">
                    <Button x:Name="UseBtn" Content="Apply to step" Width="120" Click="UseInPipeline_Click" HorizontalAlignment="Left" />
                </WrapPanel>
                <DataGrid x:Name="GridOut" Visibility="Collapsed" AutoGenerateColumns="True" IsReadOnly="True" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
