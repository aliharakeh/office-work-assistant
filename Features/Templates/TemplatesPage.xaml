<UserControl x:Class="OfficeWorkAssistant.Features.Templates.TemplatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White">
    <DockPanel Margin="0,4,0,0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Preview rows" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#555" />
                <ComboBox x:Name="PreviewBox" Width="96" SelectionChanged="PreviewBox_SelectionChanged" />
            </StackPanel>
        </DockPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="0" />
                </Grid.ColumnDefinitions>

                <GroupBox Header="Template" Grid.Column="0" Margin="0">
                    <StackPanel Margin="6">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" VerticalAlignment="Center" />
                            <TextBox x:Name="TemplateName" Grid.Column="1" />
                        </Grid>
                        <CheckBox x:Name="KeepSource" Content="Keep source columns" IsChecked="True" Margin="0,0,0,6"
                                  Checked="KeepSource_Changed" Unchecked="KeepSource_Changed" />
                        <DockPanel Margin="0,0,0,6" LastChildFill="False">
                            <TextBlock Text="Source columns" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <CheckBox x:Name="SelectAllSource" Content="Select all" Margin="12,0,0,0" VerticalAlignment="Center"
                                      IsThreeState="True" Click="SelectAllSource_Click" />
                        </DockPanel>
                        <ScrollViewer MaxHeight="110" Margin="0,0,0,6"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SourceColumnList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding Include, Mode=TwoWay}"
                                                  Margin="0,0,12,4" Checked="SourceColumn_Changed" Unchecked="SourceColumn_Changed" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="Extra columns" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ListBox x:Name="ColumnList" Height="90" Margin="0,0,0,6"
                                 SelectionChanged="Columns_SelectionChanged" />
                        <WrapPanel Margin="0,0,0,6">
                            <Button x:Name="AddUpdateBtn" Content="Add column" Width="100" Margin="0,0,8,0" Click="AddUpdate_Click" />
                            <Button Content="Remove" Width="80" Margin="0,0,8,0" Click="Remove_Click" />
                            <Button Content="Clear" Width="70" Click="ClearEditor_Click" />
                        </WrapPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Col name" VerticalAlignment="Center" />
                            <TextBox x:Name="ColName" Grid.Column="1" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="2" Text="Kind" VerticalAlignment="Center" />
                            <ComboBox x:Name="ColKind" Grid.Column="3" SelectionChanged="Kind_SelectionChanged">
                                <ComboBoxItem Content="Fixed value" />
                                <ComboBoxItem Content="Copy column" />
                                <ComboBoxItem Content="Combine text" />
                                <ComboBoxItem Content="Math" />
                                <ComboBoxItem Content="Conditional" />
                            </ComboBox>
                        </Grid>
                        <StackPanel x:Name="PanelFixed" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Value" VerticalAlignment="Center" />
                                <TextBox x:Name="FixedValue" Grid.Column="1" />
                            </Grid>
                            <TextBlock Text="Plain text, or a built-in like $Today. See Variables below." Foreground="#666" Margin="90,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="PanelCopy" Margin="0,0,0,6" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="From column" VerticalAlignment="Center" />
                                <ComboBox x:Name="CopySource" Grid.Column="1" />
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="PanelConcat" Margin="0,0,0,6" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Pattern" VerticalAlignment="Center" />
                                <TextBox x:Name="ConcatPattern" Grid.Column="1" />
                            </Grid>
                            <TextBlock Text="Use $A $B for columns (A = 1st, B = 2nd, ...). E.g. $A $B. Built-ins like $Today work too." Foreground="#666" Margin="90,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="PanelMath" Margin="0,0,0,6" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Formula" VerticalAlignment="Center" />
                                <TextBox x:Name="MathExpression" Grid.Column="1" />
                            </Grid>
                            <TextBlock Text="Mix $A $B columns, $Today-style variables, numbers, text in quotes and + - * / ^ with ( ). E.g. $A * $B, $Today + 1, ADDDAYS($Today, 7), FORMAT($Today, &quot;dd/MM/yyyy&quot;). Comparisons and IF also work, e.g. IF($A > 10, &quot;Big&quot;, &quot;Small&quot;). FIRSTWORD() and LASTWORD() pick words from a text." Foreground="#666" Margin="90,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="PanelConditional" Margin="0,0,0,6" Visibility="Collapsed">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Condition" VerticalAlignment="Center" />
                                <TextBox x:Name="CondCondition" Grid.Column="1" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Then value" VerticalAlignment="Center" />
                                <TextBox x:Name="CondTrue" Grid.Column="1" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Else value" VerticalAlignment="Center" />
                                <TextBox x:Name="CondFalse" Grid.Column="1" />
                            </Grid>
                            <TextBlock Text="Condition uses &gt; &gt;= == &lt; &lt;= != with &amp;&amp; || !, e.g. $A &gt; 10 &amp;&amp; $B == &quot;OK&quot; or $C &gt; $Today. Then/Else are formulas like $B * 2 or text in quotes." Foreground="#666" Margin="90,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <DockPanel Margin="0,0,0,6" LastChildFill="False">
                            <Button Content="Built-in variables..." Width="140" DockPanel.Dock="Left" Click="Variables_Click" />
                            <TextBlock Text="Dates like $Today work in every kind." Foreground="#666" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Data file" Grid.Column="1" Visibility="Collapsed">
                    <DockPanel LastChildFill="True" Margin="6">
                        <TextBox x:Name="SourcePath" DockPanel.Dock="Top" IsReadOnly="True" Margin="0,0,0,6" />
                        <TextBlock x:Name="InfoSource" DockPanel.Dock="Top" Margin="0,0,0,6" Foreground="#777"
                                   FontSize="11" Text="No file loaded." />
                        <DataGrid x:Name="GridSource" AutoGenerateColumns="True" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" />
                    </DockPanel>
                </GroupBox>
            </Grid>

            <StackPanel Grid.Row="1">
                <WrapPanel Margin="0,0,0,6">
                    <Button x:Name="UseBtn" Content="Apply to step" Width="120" Margin="0,0,8,0" Click="UseInPipeline_Click" />
                    <Button Content="Save template..." Width="120" Margin="0,0,8,0" Click="SaveTemplate_Click" />
                    <Button Content="Load template..." Width="120" Click="LoadTemplate_Click" />
                </WrapPanel>
                <DataGrid x:Name="GridOut" Visibility="Collapsed" AutoGenerateColumns="True" IsReadOnly="True" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
