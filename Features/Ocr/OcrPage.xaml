<UserControl x:Class="OfficeWorkAssistant.Features.Ocr.OcrPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <StackPanel Margin="0,4,0,0">
        <TextBlock x:Name="InputInfo" Foreground="#777" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />
        <TextBlock Text="Image path column" Margin="0,0,0,3" />
        <ComboBox x:Name="PathColumnBox" AutomationProperties.Name="Image path column" />
        <TextBlock Text="New text column" Margin="0,8,0,3" />
        <TextBox x:Name="TextHeaderBox" AutomationProperties.Name="New text column" />
        <TextBlock Text="Language" Margin="0,8,0,3" />
        <ComboBox x:Name="LanguagesBox" DisplayMemberPath="Key" SelectedValuePath="Value" AutomationProperties.Name="OCR language" />
        <TextBlock Text="Lists the languages installed in the app's tessdata folder."
                   Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
        <TextBlock Text="Reads PNG, JPEG, BMP and all pages of TIFF images locally. Full image paths are required. Blank paths stay blank; missing or unreadable images stop the step. No PDF or table reconstruction. OCR runs during preview too and large batches can take time."
                   Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
        <Button Content="Apply to step" Width="120" HorizontalAlignment="Left" Margin="0,8,0,6" Click="Apply_Click" />
        <TextBlock x:Name="Status" Foreground="#777" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
