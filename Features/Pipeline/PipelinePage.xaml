<Page x:Class="OfficeWorkAssistant.Features.Pipeline.PipelinePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Office Work Assistant"
      Background="#F4F6F8">
    <Page.Resources>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="Background" Value="#1E88E5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1565C0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SideHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#607D8B" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>
    </Page.Resources>

    <DockPanel>
        <!-- Header: the open pipeline and what to do with it. -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDE3E8" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Save" Style="{StaticResource BarButton}" Click="Save_Click" ToolTip="Save to Documents\Office Work Assistant\Pipelines (Ctrl+S)" />
                    <Button Content="Run preview" Style="{StaticResource BarButton}" Click="RunPreview_Click"
                            ToolTip="Run the selected step and the steps it needs (or every step when none is selected). Nothing is written or changed. (F5)" />
                    <Button Content="Run and save files" Style="{StaticResource PrimaryButton}" Click="RunAll_Click"
                            ToolTip="Read every file again, run every step, then carry out the file steps and write every Save step's file." />
                    <Button Content="Formula guide" Style="{StaticResource BarButton}" Margin="18,0,0,0" Click="FormulaGuide_Click"
                            ToolTip="Learn and try the formula language." />
                </StackPanel>
                <TextBlock Text="Office Work Assistant" Foreground="#607D8B" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Grid VerticalAlignment="Center" MaxWidth="420" HorizontalAlignment="Left">
                    <TextBox x:Name="NameBox" FontSize="16" FontWeight="SemiBold" Padding="4,2" MinWidth="260"
                             TextChanged="NameBox_TextChanged" ToolTip="The pipeline's name. Save stores it under this name; changing it renames the saved pipeline." />
                    <TextBlock x:Name="NameHint" Text="Untitled pipeline" FontSize="16" Foreground="#9E9E9E" Margin="8,3,0,0" IsHitTestVisible="False" />
                </Grid>
                <TextBlock x:Name="DirtyMark" Text="  unsaved changes" Foreground="#E65100" VerticalAlignment="Center" Visibility="Collapsed" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DDE3E8" BorderThickness="0,1,0,0" Padding="12,4">
            <TextBlock x:Name="Status" Foreground="#555" TextWrapping="Wrap"
                       Text="Click a step on the left to add it, or drag it onto the canvas. Drag from a step's right dot to another step's left dot to link them." />
        </Border>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="180" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: saved pipelines and the steps to add. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" MinHeight="120" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="2*" MinHeight="160" />
                </Grid.RowDefinitions>

                <Border Background="White" BorderBrush="#DDE3E8" BorderThickness="1" CornerRadius="4" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="SAVED PIPELINES" Style="{StaticResource SideHeader}" />
                        <WrapPanel DockPanel.Dock="Top">
                            <Button Content="New" Style="{StaticResource SmallButton}" Click="New_Click" ToolTip="Start an empty pipeline (Ctrl+N)." />
                            <Button Content="Duplicate" Style="{StaticResource SmallButton}" Click="Duplicate_Click" ToolTip="Copy the selected pipeline." />
                            <Button Content="Delete" Style="{StaticResource SmallButton}" Click="DeletePipeline_Click" ToolTip="Move the selected pipeline to the Recycle Bin." />
                            <Button Content="Import..." Style="{StaticResource SmallButton}" Click="Import_Click" ToolTip="Copy a pipeline file from elsewhere into the list." />
                            <Button Content="Folder" Style="{StaticResource SmallButton}" Click="OpenFolder_Click" ToolTip="Show the pipelines folder in Explorer." />
                        </WrapPanel>
                        <TextBlock x:Name="NoPipelines" DockPanel.Dock="Top" Foreground="#9E9E9E" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="No saved pipelines yet. Build one and click Save." />
                        <ListBox x:Name="PipelineList" BorderThickness="0" Margin="0,4,0,0"
                                 SelectionChanged="PipelineList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,3">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ModifiedText}" FontSize="10" Foreground="#9E9E9E" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

                <Border Grid.Row="2" Background="White" BorderBrush="#DDE3E8" BorderThickness="1" CornerRadius="4" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="ADD A STEP" Style="{StaticResource SideHeader}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="Palette" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="160" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="220" MinHeight="80" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="290" />
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="#DDE3E8" BorderThickness="1" CornerRadius="4" Background="White">
                        <Grid>
                            <ScrollViewer x:Name="BoardScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Canvas x:Name="Board" Width="2400" Height="1600" Background="#FAFBFC" ClipToBounds="True" Focusable="True" AllowDrop="True" />
                            </ScrollViewer>
                            <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9E9E9E" FontSize="14"
                                       TextAlignment="Center" IsHitTestVisible="False"
                                       Text="Empty pipeline.&#x0a;Start with Load file or List folder from the list on the left." />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Margin="8,0,0,0" Background="White" BorderBrush="#DDE3E8" BorderThickness="1" CornerRadius="4" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="STEP" Style="{StaticResource SideHeader}" />
                                <TextBlock x:Name="NoSelection" Foreground="#777" TextWrapping="Wrap"
                                           Text="Select a step to see its settings and result. Double-click a step to edit it. Click a link and press Delete to remove it." />
                                <StackPanel x:Name="StepPanel" Visibility="Collapsed">
                                    <TextBlock x:Name="StepKind" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <TextBlock x:Name="StepAbout" Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock Text="Name" Margin="0,0,0,2" />
                                    <TextBox x:Name="StepTitle" Margin="0,0,0,8" TextChanged="StepTitle_TextChanged" />

                                    <StackPanel x:Name="LoadPanel">
                                        <TextBlock Text="File" Margin="0,0,0,2" />
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="Browse..." Width="72" Margin="6,0,0,0" Click="LoadBrowse_Click" />
                                            <TextBox x:Name="LoadPath" IsReadOnly="True" />
                                        </DockPanel>
                                        <TextBlock Text="Sheet" Margin="0,0,0,2" />
                                        <ComboBox x:Name="LoadSheet" Margin="0,0,0,8" SelectionChanged="LoadSheet_SelectionChanged" />
                                    </StackPanel>

                                    <StackPanel x:Name="SavePanel">
                                        <RadioButton x:Name="SaveNewFile" Content="New file (replaces it)" Margin="0,0,0,2" Checked="SaveMode_Changed" />
                                        <RadioButton x:Name="SaveNewSheet" Content="New sheet in a workbook" Margin="0,0,0,6" Checked="SaveMode_Changed" />
                                        <TextBlock Text="File (.xlsx)" Margin="0,0,0,2" />
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="Browse..." Width="72" Margin="6,0,0,0" Click="SaveBrowse_Click" />
                                            <TextBox x:Name="SavePath" IsReadOnly="True" />
                                        </DockPanel>
                                        <TextBlock Text="Sheet name" Margin="0,0,0,2" />
                                        <TextBox x:Name="SaveSheet" Margin="0,0,0,4" TextChanged="SaveSheet_TextChanged" />
                                        <TextBlock Text="Files are written only by Run and save files. A new sheet must not exist yet." Foreground="#777"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    </StackPanel>

                                    <Button x:Name="EditBtn" Content="Edit step..." Margin="0,0,0,6" Padding="0,3" Click="EditStep_Click" />
                                    <Button Content="Delete step" Margin="0,0,0,8" Click="Delete_Click" />
                                    <TextBlock x:Name="StepError" Foreground="#C62828" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="LinkPanel" Visibility="Collapsed">
                                    <TextBlock x:Name="LinkText" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <Button Content="Delete link" Click="Delete_Click" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

                <Border Grid.Row="2" Background="White" BorderBrush="#DDE3E8" BorderThickness="1" CornerRadius="4" Padding="8">
                    <DockPanel>
                        <TextBlock x:Name="InfoOut" DockPanel.Dock="Top" Margin="0,0,0,6" Foreground="#777" FontSize="11"
                                   Text="Select a step and click Run preview." />
                        <DataGrid x:Name="GridOut" AutoGenerateColumns="True" IsReadOnly="True" Background="White"
                                  BorderBrush="#DDE3E8" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF1F4"
                                  CanUserAddRows="False" HeadersVisibility="Column" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Page>
