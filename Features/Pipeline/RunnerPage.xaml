<Page x:Class="OfficeWorkAssistant.Features.Pipeline.RunnerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Run a saved pipeline"
      Background="#F4F6F8">
    <Page.Resources>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="Background" Value="#1E88E5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1565C0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SideHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#607D8B" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>
    </Page.Resources>

    <DockPanel>
        <!-- Header: what this page is for, in plain words. -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDE3E8" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource BarButton}" VerticalAlignment="Top"
                        Click="Refresh_Click" ToolTip="Look in the pipelines folder again." />
                <StackPanel>
                    <TextBlock Text="Run a saved pipeline" FontSize="16" FontWeight="SemiBold" Foreground="#37474F" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#9E9E9E" Margin="0,2,12,0"
                               Text="Pick a pipeline on the left, fill in the files it needs, then press Run. What you choose here applies to this run only; the pipeline itself is not changed." />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DDE3E8" BorderThickness="0,1,0,0" Padding="12,4">
            <TextBlock x:Name="Status" Foreground="#555" TextWrapping="Wrap" Text="Pick a pipeline on the left." />
        </Border>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: one card per saved pipeline. -->
            <Border Background="White" BorderBrush="#DDE3E8" BorderThickness="1" CornerRadius="4" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SAVED PIPELINES" Style="{StaticResource SideHeader}" />
                    <TextBlock x:Name="NoPipelines" DockPanel.Dock="Top" Foreground="#9E9E9E" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="No saved pipelines yet. Build one in Builder mode, then save it." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="Cards" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

            <!-- The form the pipeline needs, filled in below the buttons when Check or Run is pressed. -->
            <Border Grid.Column="2" Background="White" BorderBrush="#DDE3E8" BorderThickness="1" CornerRadius="4" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="Form" Margin="4" />
                        </ScrollViewer>
                        <TextBlock x:Name="NoSelection" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9E9E9E"
                                   TextWrapping="Wrap" TextAlignment="Center" Text="Pick a pipeline on the left to see what it needs." />
                    </Grid>

                    <Border x:Name="ResultBox" Grid.Row="1" Background="#F7F9FA" BorderBrush="#DDE3E8" BorderThickness="1"
                            CornerRadius="4" Padding="10" Margin="0,8,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ResultTitle" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock x:Name="Result" TextWrapping="Wrap" Foreground="#37474F" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Page>
