<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OfficeWorkAssistant.Features.ExcelProcessing.ExcelProcessingPage" Background="White">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OfficeWorkAssistant;component/Excel/EditorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,4,0,0">
        <StackPanel Margin="0,0,0,8" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Preview rows" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#555" TextWrapping="Wrap" />
                <ComboBox x:Name="PreviewBox" SelectionChanged="PreviewBox_SelectionChanged" HorizontalAlignment="Stretch" />
            </StackPanel>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,8" Visibility="Collapsed">
                <GroupBox Header="File A" Margin="0,0,0,6">
                    <StackPanel Margin="6">
                        <TextBox x:Name="PathA" IsReadOnly="True" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="InfoA" Margin="0,0,0,6" Foreground="#777" FontSize="11" Text="No file loaded." TextWrapping="Wrap" />
                        <DataGrid x:Name="GridA" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="File B" Margin="0,0,0,6">
                    <StackPanel Margin="6">
                        <TextBox x:Name="PathB" IsReadOnly="True" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="InfoB" Margin="0,0,0,6" Foreground="#777" FontSize="11" Text="No file loaded." TextWrapping="Wrap" />
                        <DataGrid x:Name="GridB" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            <GroupBox Header="Match rules" Grid.Row="1" Margin="0,0,0,8">
                <StackPanel Margin="4">
                    <StackPanel Margin="0,0,0,4">
                        <Button Content="Add" Width="56" Click="AddCond_Click" HorizontalAlignment="Left" />
                        <ComboBox x:Name="MatchMode" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="Op_SelectionChanged">
                            <ComboBoxItem Content="AND — all rules" />
                            <ComboBoxItem Content="OR — any rule" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="CondPanel" />
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Output" Grid.Row="2">
                <StackPanel Margin="6">
                    <ListBox x:Name="OpList" Margin="0,0,0,6" SelectionChanged="Op_SelectionChanged">
                        <ListBoxItem Content="Found in A but not in B" Tag="AOnly" />
                        <ListBoxItem Content="Found in B but not A" Tag="BOnly" />
                        <ListBoxItem Content="Common between A &amp; B" Tag="Common" />
                    </ListBox>
                    <StackPanel Margin="0,0,0,6">
                        <StackPanel Margin="0,0,0,6">
                            <CheckBox x:Name="PickA" Content="All A" Margin="0,0,12,0" VerticalAlignment="Center" IsThreeState="True" Click="PickA_Click" />
                            <CheckBox x:Name="PickB" Content="All B" Margin="0,0,12,0" VerticalAlignment="Center" IsThreeState="True" Click="PickB_Click" />
                            <CheckBox x:Name="PickBoth" Content="All" Margin="0,0,12,0" VerticalAlignment="Center" IsThreeState="True" Click="PickBoth_Click" />
                            <Button x:Name="UseBtn" Content="Apply to step" Width="120" Click="UseInPipeline_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ScrollViewer MaxHeight="72" Margin="0,0,0,6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ColList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding Include, Mode=TwoWay}" Margin="0,0,12,4" Checked="Col_Changed" Unchecked="Col_Changed" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <DataGrid x:Name="GridOut" Visibility="Collapsed" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
    </StackPanel>
</UserControl>
