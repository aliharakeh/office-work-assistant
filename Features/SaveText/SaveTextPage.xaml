<UserControl x:Class="OfficeWorkAssistant.Features.SaveText.SaveTextPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="White">
    <StackPanel Margin="0,4,0,0">
        <TextBlock x:Name="InputInfo" Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
        <TextBlock Text="Format" Margin="0,0,0,3" />
        <ComboBox x:Name="FormatBox" AutomationProperties.Name="Text or JSON format" SelectionChanged="Format_Changed">
            <ComboBoxItem Content="Text column" />
            <ComboBoxItem Content="Text map (key + tab + value)" />
            <ComboBoxItem Content="JSON array (list / set)" />
            <ComboBoxItem Content="JSON object (map)" />
        </ComboBox>
        <TextBlock Text="Text / key column" Margin="0,8,0,3" />
        <ComboBox x:Name="ColumnBox" AutomationProperties.Name="Text or key column" />
        <TextBlock Text="Value column (map formats only)" Margin="0,8,0,3" />
        <ComboBox x:Name="ValueColumnBox" AutomationProperties.Name="Map value column" />
        <TextBlock Text="Output file (full path)" Margin="0,8,0,3" />
        <TextBox x:Name="PathBox" AutomationProperties.Name="Text or JSON output file" />
        <TextBlock Text="Use Choose output file above, or type a full path. With no extension, text uses .txt and JSON uses .json. Any explicit extension is kept; changing the extension does not change the format."
                   Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
        <TextBlock Text="Writes one UTF-8 file for all rows, without a header. Text keeps line breaks (including OCR paragraphs); map pairs use a tab. JSON arrays preserve row order and duplicates; sets are already unique upstream. JSON objects require unique, non-null keys. Preview shows Content and never writes files. Existing files are replaced only on Run and save files, after confirmation."
                   Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
        <Button Content="Apply to step" Width="120" HorizontalAlignment="Left" Margin="0,8,0,6" Click="Apply_Click" />
        <TextBlock x:Name="Status" Foreground="#777" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
