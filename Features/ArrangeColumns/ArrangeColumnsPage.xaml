<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OfficeWorkAssistant.Features.ArrangeColumns.ArrangeColumnsPage" Background="White">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OfficeWorkAssistant;component/Excel/EditorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,4,0,0">
        <TextBlock x:Name="InputInfo" Foreground="#777" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />
        <GroupBox Header="Columns, in output order">
            <StackPanel Margin="6">
                <TextBlock Text="Click a column's name to select it, then use Up / Down to move it. Tick its box to keep it; type a new name to rename it." Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,6" />
                <ListBox x:Name="ColumnList" Height="260" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Background="Transparent">
                                <CheckBox IsChecked="{Binding Keep, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,0,4" ToolTip="Keep this column" Content="{Binding Label}" />
                                <TextBlock Text="New header (blank keeps the current name)" TextWrapping="Wrap" Margin="0,2,0,2" />
                                <TextBox Text="{Binding Header, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="New header. Blank keeps the current one." Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="Up" Width="50" Margin="0,0,6,4" Click="Up_Click" HorizontalAlignment="Left" />
                    <Button Content="Down" Width="56" Margin="0,0,6,4" Click="Down_Click" HorizontalAlignment="Left" />
                    <Button Content="Keep all" Width="70" Margin="0,0,6,4" Click="KeepAll_Click" HorizontalAlignment="Left" />
                    <Button Content="Keep none" Width="76" Margin="0,0,6,4" Click="KeepNone_Click" HorizontalAlignment="Left" />
                    <Button Content="Undo renames" Width="96" Margin="0,0,6,4" Click="ClearNames_Click" HorizontalAlignment="Left" />
                </WrapPanel>
                <CheckBox x:Name="KeepNewBox" Content="Also keep columns that are not in this list (added by an earlier step later on), at the end" Margin="0,4,0,0" />
            </StackPanel>
        </GroupBox>
        <Button Content="Apply to step" Width="120" HorizontalAlignment="Left" Margin="0,8,0,6" Click="Apply_Click" />
        <TextBlock x:Name="Status" Foreground="#777" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
