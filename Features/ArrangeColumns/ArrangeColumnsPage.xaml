<UserControl x:Class="OfficeWorkAssistant.Features.ArrangeColumns.ArrangeColumnsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White">
    <StackPanel Margin="0,4,0,0">
        <TextBlock x:Name="InputInfo" Foreground="#777" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />
        <GroupBox Header="Columns, in output order">
            <StackPanel Margin="6">
                <TextBlock Text="Click a column's name to select it, then use Up / Down to move it. Tick its box to keep it; type a new name to rename it."
                           Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,6" />
                <ListBox x:Name="ColumnList" Height="260" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <!-- The label is separate from the box, so clicking the name selects the row. -->
                                <CheckBox IsChecked="{Binding Keep, Mode=TwoWay}" VerticalAlignment="Center" Margin="2,0,8,0"
                                          ToolTip="Keep this column" />
                                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="2" Text="{Binding Header, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="New header. Blank keeps the current one." />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="Up" Width="50" Margin="0,0,6,4" Click="Up_Click" />
                    <Button Content="Down" Width="56" Margin="0,0,6,4" Click="Down_Click" />
                    <Button Content="Keep all" Width="70" Margin="0,0,6,4" Click="KeepAll_Click" />
                    <Button Content="Keep none" Width="76" Margin="0,0,6,4" Click="KeepNone_Click" />
                    <Button Content="Undo renames" Width="96" Margin="0,0,6,4" Click="ClearNames_Click" />
                </WrapPanel>
                <CheckBox x:Name="KeepNewBox" Content="Also keep columns that are not in this list (added by an earlier step later on), at the end"
                          Margin="0,4,0,0" />
            </StackPanel>
        </GroupBox>
        <Button Content="Apply to step" Width="120" HorizontalAlignment="Left" Margin="0,8,0,6" Click="Apply_Click" />
        <TextBlock x:Name="Status" Foreground="#777" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
