<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OfficeWorkAssistant.Features.FillColumns.FillColumnsPage" Background="White">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OfficeWorkAssistant;component/Excel/EditorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,4,0,0">
        <TextBlock Text="Output sheet" FontWeight="SemiBold" />
        <ComboBox x:Name="OutputSheet" Margin="0,2,0,8">
            <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Match formula (optional)" FontWeight="SemiBold" />
        <TextBox x:Name="MatchFormula" Margin="0,2,0,4" TextWrapping="Wrap" />
        <TextBlock x:Name="MatchHint" TextWrapping="Wrap" Margin="0,0,0,5" />
        <Expander Header="Input columns" Margin="0,0,0,12">
            <TextBlock x:Name="InputColumns" TextWrapping="Wrap" />
        </Expander>
        <TextBlock Text="Fill rules" FontWeight="SemiBold" />
        <TextBlock Text="Rules run from top to bottom. The first matching rule for a cell sets its value." TextWrapping="Wrap" Foreground="#555" Margin="0,2,0,6" />
        <StackPanel x:Name="RulePanel" />
        <Button Content="Add fill rule" Click="AddRule_Click" HorizontalAlignment="Left" Margin="0,2,0,8" />
        <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,4" />
        <Button x:Name="UseBtn" Content="Apply to step" Click="UseInPipeline_Click" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
