<Page x:Class="WorkAssistant.Features.MergeDuplicates.MergeDuplicatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Merge Duplicates"
      Background="White">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
            <Button DockPanel.Dock="Left" Content="Home" Width="72" Margin="0,0,12,0" Click="Home_Click" />
            <TextBlock Text="Merge Duplicates" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Preview" Width="100" Margin="0,0,8,0" Click="Preview_Click" />
            <Button Content="Merge" Width="100" Click="Merge_Click" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="170" />
            </Grid.RowDefinitions>

            <GroupBox Header="Duplicate folders" Margin="0,0,0,8">
                <StackPanel Margin="6">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Parent" VerticalAlignment="Center" />
                        <TextBox x:Name="PathParent" Grid.Column="1" IsReadOnly="True" Margin="0,0,6,0" />
                        <Button Grid.Column="2" Content="Browse..." Width="88" Click="BrowseParent_Click" />
                    </Grid>
                    <WrapPanel>
                        <TextBlock Text="Separator" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <ComboBox x:Name="SepBox" Width="110" Margin="0,0,8,6" SelectedIndex="1" SelectionChanged="SepBox_Changed">
                            <ComboBoxItem Content="Space" />
                            <ComboBoxItem Content="Underscore" />
                            <ComboBoxItem Content="Dash" />
                            <ComboBoxItem Content="Custom" />
                        </ComboBox>
                        <TextBox x:Name="CustomSep" Width="40" MaxLength="1" IsEnabled="False" Margin="0,0,16,6" />
                        <TextBlock Text="Match" VerticalAlignment="Center" Margin="0,0,6,6"
                                   ToolTip="Formula comparing two folders. {A} {B} are names, {A1} {B2} or $A1 $B2 are split parts." />
                        <TextBox x:Name="ConditionBox" Width="260" Text="{}{A1} == {B1}" Margin="0,0,8,6"
                                 ToolTip="Example: {A1} == {B1} &amp;&amp; CONTAINS({A}, &quot;2024&quot;). Same formula language as Copy Files." />
                        <Button Content="Variables..." Width="88" Margin="0,0,0,6" Click="Variables_Click" />
                    </WrapPanel>
                    <TextBlock Text="Split each folder name by the separator. The match formula must be true for a pair. {A} is one folder name, {B} the other. Each group lists every folder that matches; pick which one to keep."
                               Foreground="#666" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <GroupBox Header="Groups" Grid.Column="0" Margin="0,0,6,0">
                    <DockPanel Margin="6" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" x:Name="GroupCount" Foreground="#666" Margin="0,0,0,4" Text="No preview yet." />
                        <ListBox x:Name="GroupsList" SelectionChanged="GroupsList_SelectionChanged" />
                    </DockPanel>
                </GroupBox>

                <GroupBox Header="Merge into" Grid.Column="1" Margin="6,0,0,0">
                    <DockPanel Margin="6" LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Keep" VerticalAlignment="Center" />
                            <ComboBox x:Name="TargetBox" Grid.Column="1" SelectionChanged="TargetBox_SelectionChanged" />
                        </Grid>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
                            <TextBlock Text="Tick folders to merge:" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="None" Width="60" Margin="6,0,0,0" Click="SelectNone_Click" />
                            <Button DockPanel.Dock="Right" Content="All" Width="60" Margin="6,0,0,0" Click="SelectAll_Click" />
                        </DockPanel>
                        <ListBox x:Name="MembersList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Include, Mode=TwoWay}" IsEnabled="{Binding CanMerge}" Margin="0,2,0,2" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </GroupBox>
            </Grid>

            <GroupBox Header="Merge result" Grid.Row="2">
                <DataGrid x:Name="PlansGrid" AutoGenerateColumns="True" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column" Margin="6" />
            </GroupBox>
        </Grid>
    </DockPanel>
</Page>
