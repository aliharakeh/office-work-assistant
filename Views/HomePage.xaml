<Page x:Class="WorkAssistant.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Home"
      Background="#F3F3F3">
    <DockPanel Margin="28">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="Work Assistant" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Pick a tool." FontSize="14" Foreground="#666" Margin="0,6,0,0" />
        </StackPanel>
        <WrapPanel>
            <Button Width="260" Height="140" Padding="16" Margin="0,0,12,12"
                    HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                    Click="ExcelCard_Click">
                <StackPanel>
                    <TextBlock Text="Excel Processing" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Compare two workbooks by a key column, preview the rows, then pick which columns to save."
                               TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#555" />
                </StackPanel>
            </Button>
            <Button Width="260" Height="140" Padding="16" Margin="0,0,12,12"
                    HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                    Click="FilesCard_Click">
                <StackPanel>
                    <TextBlock Text="Copy Files" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Copy files, split names, rename with $1 $2 parts, optional wrapper folder."
                               TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#555" />
                </StackPanel>
            </Button>
            <Button Width="260" Height="140" Padding="16" Margin="0,0,12,12"
                    HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                    Click="FoldersCard_Click">
                <StackPanel>
                    <TextBlock Text="Merge Duplicates" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Find duplicate folders by split-name rules, pick which one to keep, then merge."
                               TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#555" />
                </StackPanel>
            </Button>
            <Button Width="260" Height="140" Padding="16" Margin="0,0,12,12"
                    HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                    Click="TemplatesCard_Click">
                <StackPanel>
                    <TextBlock Text="Templates" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Build a reusable Excel template: keep source columns, add fixed, copied, combined or math columns."
                               TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#555" />
                </StackPanel>
            </Button>
        </WrapPanel>
    </DockPanel>
</Page>
